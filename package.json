{
  "name": "capstone-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Capstone Project Backend Boilerplate",
  "main": "src/index.js",
  "author": "Rengga Rendi Saputra <renggarendy22@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "cross-env NODE_ENV=development nodemon src/index.js",
    "build": "npx prisma generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check **/*.js",
    "prettier:fix": "prettier --write **/*.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -i --colors --verbose --detectOpenHandles",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -i --watchAll",
    "coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -i --coverage"
  },
  "keywords": [
    "node",
    "express",
    "rest",
    "api",
    "boilerplate",
    "prisma",
    "jwt",
    "passport",
    "joi",
    "eslint",
    "prettier"
  ],
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.0",
    "helmet": "^8.0.0",
    "http-status": "^2.1.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.9.1",
    "multer": "^2.1.1",
    "mysql2": "^3.19.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "prisma": "^6.19.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0",
    "validator": "^13.15.0",
    "winston": "^3.19.0",
    "xss": "^1.0.15",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-security": "^1.4.0",
    "jest": "^30.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "supertest": "^7.0.0"
  }
}
